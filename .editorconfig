root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.ps1]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.java]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
